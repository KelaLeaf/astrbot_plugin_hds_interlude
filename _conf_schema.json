{
  "model": {
    "type": "object",
    "description": "主叙事模型连接。留空则用 AstrBot 默认模型。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "用下方独立连接，否则走 AstrBot 默认模型。",
        "default": false
      },
      "endpoint": {
        "type": "string",
        "description": "Chat Completions 完整地址",
        "hint": "例: https://api.xxx.com/v1/chat/completions",
        "default": ""
      },
      "api_key": {
        "type": "string",
        "description": "接口密钥",
        "default": ""
      },
      "model": {
        "type": "string",
        "description": "模型名",
        "hint": "例: gpt-4o-mini",
        "default": ""
      },
      "temperature": {
        "type": "float",
        "description": "采样温度",
        "default": 0.8,
        "slider": {"min": 0, "max": 2, "step": 0.1}
      },
      "max_tokens": {
        "type": "int",
        "description": "最大输出 token",
        "default": 4096
      },
      "timeout_seconds": {
        "type": "int",
        "description": "请求超时（秒）",
        "default": 60
      }
    }
  },
  "story": {
    "type": "object",
    "description": "剧本起点",
    "items": {
      "character_name": {
        "type": "string",
        "description": "主角名",
        "default": "Unnamed character"
      },
      "character_profile": {
        "type": "text",
        "description": "角色设定",
        "hint": "背景、性格、说话方式",
        "default": ""
      },
      "world": {
        "type": "text",
        "description": "世界设定",
        "hint": "时代、地点、规则",
        "default": ""
      },
      "style": {
        "type": "text",
        "description": "叙事文风",
        "default": "现实主义日常叙事，情绪克制，关系变化缓慢而具体。"
      },
      "timezone": {
        "type": "string",
        "description": "时区",
        "hint": "例: Asia/Shanghai",
        "default": "Asia/Shanghai"
      }
    }
  },
  "runtime": {
    "type": "object",
    "description": "对话与时间",
    "items": {
      "capture_direct_messages": {
        "type": "bool",
        "description": "拦截私聊文本",
        "default": true
      },
      "auto_create": {
        "type": "bool",
        "description": "无剧本时自动启动",
        "default": false
      },
      "allowed_user_ids": {
        "type": "list",
        "description": "允许互动的用户 ID",
        "hint": "留空放行所有；如 [\"12345\"]",
        "default": []
      },
      "context_entry_limit": {
        "type": "int",
        "description": "最近剧本条目数",
        "default": 30
      },
      "memory_limit": {
        "type": "int",
        "description": "长期事实数量",
        "default": 20
      },
      "min_delayed_reply_seconds": {
        "type": "int",
        "description": "最短延迟回复（秒）",
        "default": 10
      },
      "max_delayed_reply_minutes": {
        "type": "int",
        "description": "最长延迟回复（分钟）",
        "default": 1440
      }
    }
  },
  "prompts": {
    "type": "object",
    "description": "叙事提示词",
    "items": {
      "main_prompt": {
        "type": "text",
        "description": "主叙事指令",
        "default": "Continue the character-centered life script with grounded actions, motives, relationships, and ordinary time passing."
      },
      "style_prompt": {
        "type": "text",
        "description": "全局文风",
        "default": "Use restrained, realistic prose with concrete daily details, natural pauses, and no forced drama."
      }
    }
  }
}
